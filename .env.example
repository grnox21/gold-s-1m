# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Never prefix with NEXT_PUBLIC_ — this bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Public site URL, used for metadata/Open Graph and password-reset redirects.
# Local dev: http://localhost:3000 — Production: https://yusufdemir.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects /api/cron/reminders. Vercel Cron automatically sends this as
# `Authorization: Bearer $CRON_SECRET` — generate any random string.
CRON_SECRET=

# --- WhatsApp (optional — the app falls back to wa.me click-to-chat links
# for any provider whose credentials are missing) --------------------------

# Meta WhatsApp Cloud API
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_API_VERSION=v21.0

# Twilio WhatsApp
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM_NUMBER=whatsapp:+14155238886

# --- Email to the shop owner (new booking + 30-min reminder) --------------
# Without these, owner emails are silently skipped (not an error) — see
# lib/email/send.ts. Get an API key at https://resend.com; RESEND_FROM_EMAIL
# must be an address on a domain verified in the Resend dashboard, or every
# send fails even with a valid key. The recipient address itself is set in
# Site Ayarları (owner_notification_email in site_settings), not here.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
